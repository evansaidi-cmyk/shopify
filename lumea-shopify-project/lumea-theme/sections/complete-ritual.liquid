<section class="section">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% assign coll = collections[section.settings.collection] %}
    {% if coll != blank and coll.products.size > 0 %}
      <div class="carousel" id="carousel-{{ section.id }}">
        {% for product in coll.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="carousel">
        <div class="product-card">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}
          <div class="product-card__title">Café Collagène</div>
          <div class="product-card__price">À partir de 29€</div>
        </div>
        <div class="product-card">
          {{ 'product-2' | placeholder_svg_tag: 'product-card__img' }}
          <div class="product-card__title">Matcha Collagène</div>
          <div class="product-card__price">À partir de 32€</div>
        </div>
        <div class="product-card">
          {{ 'product-3' | placeholder_svg_tag: 'product-card__img' }}
          <div class="product-card__title">Coffret Découverte</div>
          <div class="product-card__price">À partir de 45€</div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Complète le rituel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Complète ton rituel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "On te recommande aussi"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de produits",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Complète le rituel"
    }
  ]
}
{% endschema %}
