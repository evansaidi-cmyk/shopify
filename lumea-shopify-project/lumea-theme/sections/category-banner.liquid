<section class="section"><div class="container"><div class="category-banner"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1><p class="section__subtext">{{ section.settings.text }}</p><div class="category-banner__benefits">{% for block in section.blocks %}<div class="category-banner__benefit" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{% endfor %}</div></div></div></section>

{% schema %}
{
  "name": "Bandeau catégorie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Collection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos rituels collagène" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Café, matcha et coffrets pour sublimer ta routine bien-être." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Avantage",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau catégorie",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Livraison offerte", "text": "Dès 49€ d'achat" } },
        { "type": "benefit", "settings": { "title": "Paiement sécurisé", "text": "3x sans frais" } },
        { "type": "benefit", "settings": { "title": "Satisfait ou remboursé", "text": "Sous 30 jours" } }
      ]
    }
  ]
}
{% endschema %}
