<section class="hero">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hero__bg', alt: '' }}
  {% else %}
    <img class="hero__bg" src="{{ section.settings.image_url }}" alt="">
  {% endif %}
  <div class="hero__overlay"></div>
  <div class="container">
    <div class="hero__content">
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      {% if section.settings.button_label != blank %}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
      <p class="hero__proof"><span class="stars">★★★★★</span> {{ section.settings.proof }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "URL de l'image",
      "default": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1600&q=80"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Café & Matcha au collagène"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Le rituel du matin, réinventé"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Sublime ta peau et ton énergie avec nos boissons premium enrichies en collagène marin."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "text",
      "id": "proof",
      "label": "Preuve sociale",
      "default": "+1 200 avis"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
