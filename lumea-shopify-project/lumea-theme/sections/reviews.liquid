<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="carousel">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <span class="stars">★★★★★</span>
          <p class="review-card__text">{{ block.settings.text }}</p>
          <div class="review-card__name">{{ block.settings.name }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce qu'ils en pensent"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Camille L."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "default": "Mon rituel matin préféré, je ne peux plus m'en passer !"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Camille L.",
            "text": "Le café collagène est devenu mon rituel matin incontournable. Goût délicieux et effet visible sur ma peau !"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Thomas R.",
            "text": "Pratique et savoureux, le matcha LUMÉA me donne un boost d'énergie sans la nervosité du café classique."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Sarah M.",
            "text": "J'adore la qualité des ingrédients et la facilité de préparation. Le coffret découverte est parfait pour tester."
          }
        }
      ]
    }
  ]
}
{% endschema %}
