<section class="section"><div class="container"><div class="section__head"><h2>{{ section.settings.heading }}</h2></div><table class="comparison-table"><thead><tr><th>{{ section.settings.col_feature }}</th><th>{{ section.settings.col_lumea }}</th><th>{{ section.settings.col_other }}</th></tr></thead><tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><th>{{ block.settings.feature }}</th><td class="yes">{{ block.settings.lumea }}</td><td class="no">{{ block.settings.other }}</td></tr>{% endfor %}</tbody></table></div></section>

{% schema %}
{
  "name": "Tableau comparatif",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "LUMÉA vs. le classique" },
    { "type": "text", "id": "col_feature", "label": "Colonne critère", "default": "Critère" },
    { "type": "text", "id": "col_lumea", "label": "Colonne LUMÉA", "default": "LUMÉA" },
    { "type": "text", "id": "col_other", "label": "Colonne classique", "default": "Le classique" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "feature", "label": "Critère" },
        { "type": "text", "id": "lumea", "label": "LUMÉA", "default": "✓" },
        { "type": "text", "id": "other", "label": "Le classique", "default": "✕" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "feature": "Collagène marin", "lumea": "✓", "other": "✕" } },
        { "type": "row", "settings": { "feature": "Sans sucres ajoutés", "lumea": "✓", "other": "✕" } },
        { "type": "row", "settings": { "feature": "Goût premium", "lumea": "✓", "other": "≈" } },
        { "type": "row", "settings": { "feature": "Prêt en 1 minute", "lumea": "✓", "other": "✓" } }
      ]
    }
  ]
}
{% endschema %}
