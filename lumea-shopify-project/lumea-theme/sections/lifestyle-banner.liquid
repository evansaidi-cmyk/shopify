<section class="lifestyle-banner">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'lifestyle-banner__bg', alt: '' }}
  {% else %}
    <img class="lifestyle-banner__bg" src="{{ section.settings.image_url }}" alt="">
  {% endif %}
  <div class="lifestyle-banner__overlay"></div>
  <div class="lifestyle-banner__content">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}<a class="btn btn--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau lifestyle",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "URL de l'image",
      "default": "https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=1600&q=80"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Le rituel du matin, réinventé"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Une parenthèse de bien-être, chaque jour."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Voir nos produits"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Bandeau lifestyle"
    }
  ]
}
{% endschema %}
