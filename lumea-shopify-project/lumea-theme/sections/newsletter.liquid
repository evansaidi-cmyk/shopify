<section class="section newsletter">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section__subtext">{{ section.settings.text }}</p>
    </div>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
      </div>
      {% if form.posted_successfully? %}
        <p class="newsletter__success">Merci, tu es bien inscrit·e !</p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Rejoins le mouvement LUMÉA"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Reçois nos rituels, conseils et offres exclusives."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Texte indicatif du champ",
      "default": "Ton adresse e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Je m'inscris"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
