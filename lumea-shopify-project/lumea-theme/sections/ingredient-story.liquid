<section class="section"><div class="container"><div class="ingredient-story{% if section.settings.reverse %} ingredient-story--reverse{% endif %}">
   <div class="ingredient-story__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1000 | image_tag }}{% else %}<img src="{{ section.settings.image_url }}" alt="">{% endif %}</div>
   <div class="ingredient-story__body"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div>
 </div></div></section>

{% schema %}
{
  "name": "Histoire d'ingrédient",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "URL image par défaut", "default": "https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=1200&q=80" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Origine" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un collagène marin d'exception" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Issu d'une pêche durable, notre collagène marin hydrolysé est ultra-assimilable pour des résultats visibles sur la peau, les cheveux et les ongles.</p>" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "En savoir plus" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "reverse", "label": "Inverser image/texte", "default": false }
  ],
  "presets": [
    { "name": "Histoire d'ingrédient" }
  ]
}
{% endschema %}
