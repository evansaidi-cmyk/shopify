<section class="section">
  <div class="container">
    <div class="section__head">
      <h1>{{ section.settings.heading }}</h1>
      <p class="section__subtext">{{ section.settings.intro }}</p>
    </div>
    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-note form-note--success">Merci, ton message a bien été envoyé.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="form-note form-note--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <input type="text" name="contact[name]" placeholder="Ton nom" required>
      <input type="email" name="contact[email]" placeholder="Ton e-mail" required>
      <textarea name="contact[body]" placeholder="Ton message" required></textarea>
      <button type="submit" class="btn btn--primary">Envoyer</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Contactez-nous"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Une question ? Écris-nous, nous répondons sous 48h."
    }
  ],
  "presets": [
    {
      "name": "Formulaire de contact"
    }
  ]
}
{% endschema %}
