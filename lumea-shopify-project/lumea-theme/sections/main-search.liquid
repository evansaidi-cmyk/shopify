<section class="section">
  <div class="container">
    <div class="section__head">
      <h1>Recherche</h1>
    </div>
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher un produit...">
      <button type="submit" class="btn btn--primary">Rechercher</button>
    </form>
    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p class="text-center section__subtext">{{ search.results_count }} résultat(s) pour « {{ search.terms }} »</p>
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="article-card">
                <div class="article-card__body">
                  <h3>{{ item.title }}</h3>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-center">Aucun résultat trouvé.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": [],
  "presets": [
    {
      "name": "Recherche"
    }
  ]
}
{% endschema %}
