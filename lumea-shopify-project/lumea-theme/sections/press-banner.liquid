<section class="section press-banner">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="press-banner__logos">{% for block in section.blocks %}<span class="press-banner__logo" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>{% endfor %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau presse",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils parlent de LUMÉA"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau presse",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
