<section class="section">
  <div class="container">
    <div class="section__head">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="section__subtext rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">←</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">→</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="text-center">Aucun produit dans cette collection pour le moment.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille de collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Grille de collection"
    }
  ]
}
{% endschema %}
