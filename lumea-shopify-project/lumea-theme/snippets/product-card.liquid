{%- comment -%}
  Renders a product card.
  Accepts:
  - product: {Object} product object
{%- endcomment -%}
<a href="{{ product.url }}" class="product-card">
  <div class="product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title, class: 'product-card__image' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder' }}
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge">Promo</span>
    {%- endif -%}
  </div>
  <div class="product-card__info">
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product %}
  </div>
</a>
