<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#C9806A' }};
        --color-secondary: {{ settings.color_secondary | default: '#8C9B7B' }};
        --color-background: {{ settings.color_background | default: '#F6F1E9' }};
        --color-text: {{ settings.color_text | default: '#2B2722' }};
        --color-card: #FFFFFF;
        --font-heading: 'Poppins', sans-serif;
        --font-body: 'Inter', sans-serif;
      }
    </style>
  </head>

  <body class="template-password">
    <main class="password-page" role="main">
      <div class="password-page__inner">
        {%- if settings.logo != blank -%}
          <img class="password-page__logo" src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="180">
        {%- else -%}
          <h1 class="password-page__title">LUMÉA</h1>
        {%- endif -%}

        <p class="password-page__tagline">{{ shop.name }} arrive bientôt.</p>

        {{ content_for_layout }}

        {%- form 'storefront_password', class: 'password-form' -%}
          {%- if form.errors -%}
            <p class="password-form__error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
          {%- endif -%}
          <label for="Password" class="visually-hidden">Mot de passe</label>
          <input type="password" name="password" id="Password" placeholder="Mot de passe" autocomplete="off">
          <button type="submit" class="btn btn--primary">Entrer</button>
        {%- endform -%}
      </div>
    </main>
  </body>
</html>
